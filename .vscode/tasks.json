{
	// See https://go.microsoft.com/fwlink/?LinkId=733558
	// for the documentation about the tasks.json format
	"version": "2.0.0",
	// Every task is written for a POSIX shell (&&, for-loops). PowerShell 5.1
	// rejects && as a separator, so run them through Git Bash.
	"options": {
		"shell": {
			"executable": "C:/Program Files/Git/bin/bash.exe",
			"args": ["-c"]
		}
	},

	"tasks": [
		{
			"label": "rokit install",
			"detail": "Install the pinned toolchain (rojo, selene, stylua, luau-lsp; wally in bfg-core)",
			"type": "shell",
			"command": "rokit install && cd bfg-core && rokit install",
			"group": { "kind": "build" },
			"options": { "cwd": "${workspaceFolder}" },
			"presentation": { "reveal": "always", "focus": true }
		},

		{
			"label": "update submodules",
			"detail": "Force update all submodules (bfg-core, bfg-debug) to their remote heads",
			"type": "shell",
			"command": "git submodule update --remote --force --init --recursive",
			"group": { "kind": "build" },
			"options": { "cwd": "${workspaceFolder}" },
			"presentation": { "reveal": "always", "focus": true }
		},

		{
			"label": "build wally packages",
			"detail": "Install bfg-core's Wally packages (Packages/ and ServerPackages/ are not tracked)",
			"type": "shell",
			"command": "cd bfg-core ; wally install",
			"group": { "kind": "build" },
			"options": { "cwd": "${workspaceFolder}" },
			"presentation": { "reveal": "always", "focus": true }
		},

		{
			"label": "regenerate all",
			"detail": "Rebuild both sourcemaps (Dungeons -> sourcemap.json for the editor, Lobby -> sourcemap.lobby.json). The editor rebuilds the Dungeons one itself; run this if the Problems panel fills with Unknown require after a rename or package reinstall",
			"type": "shell",
			"command": "rojo sourcemap dungeons.project.json -o sourcemap.json --include-non-scripts && rojo sourcemap lobby.project.json -o sourcemap.lobby.json --include-non-scripts",
			"group": { "kind": "build", "isDefault": true },
			"options": { "cwd": "${workspaceFolder}" },
			"presentation": { "reveal": "silent" },
			"problemMatcher": []
		},

		{
			"label": "typecheck: all",
			"detail": "Type check everything: core + Dungeons through sourcemap.json, then Lobby through sourcemap.lobby.json. The one to run before a push",
			"type": "shell",
			"command": "mkdir -p tools/luau && { [ -f tools/luau/globalTypes.d.luau ] || curl -sSfL -o tools/luau/globalTypes.d.luau https://raw.githubusercontent.com/JohnnyMorganz/luau-lsp/1.69.0/scripts/globalTypes.d.luau; } && echo '== Dungeons view (core + Dungeons) ==' && rojo sourcemap dungeons.project.json -o sourcemap.json --include-non-scripts && luau-lsp analyze --definitions tools/luau/globalTypes.d.luau --sourcemap sourcemap.json --no-strict-dm-types --ignore '**/Packages/**' --ignore '**/_Index/**' --ignore '**/Source/*/Network/**' --ignore '**/Libraries/AfterImage/**' --ignore '**/Libraries/HyperText/**' --ignore '**/Libraries/LocationMarkerSystem/**' --ignore '**/Libraries/LootPlan/**' --ignore '**/Libraries/ProfileService/**' --ignore '**/Libraries/RaycastHitbox/**' --ignore '**/Libraries/Shime.luau' --ignore '**/Libraries/ViewportModel/**' --ignore '**/Libraries/WindShake/**' bfg-core/Source bfg-core/Libraries/IsometricCamera bfg-core/Libraries/ProjectileCast bfg-core/Libraries/UserNotificationSystem Places/Dungeons && echo '== Lobby view (Lobby) ==' && rojo sourcemap lobby.project.json -o sourcemap.lobby.json --include-non-scripts && luau-lsp analyze --definitions tools/luau/globalTypes.d.luau --sourcemap sourcemap.lobby.json --no-strict-dm-types --ignore '**/Packages/**' --ignore '**/_Index/**' --ignore '**/Source/*/Network/**' --ignore '**/Libraries/AfterImage/**' --ignore '**/Libraries/HyperText/**' --ignore '**/Libraries/LocationMarkerSystem/**' --ignore '**/Libraries/LootPlan/**' --ignore '**/Libraries/ProfileService/**' --ignore '**/Libraries/RaycastHitbox/**' --ignore '**/Libraries/Shime.luau' --ignore '**/Libraries/ViewportModel/**' --ignore '**/Libraries/WindShake/**' Places/Lobby && echo 'TYPE CHECK CLEAN: both places'",
			"group": { "kind": "test", "isDefault": true },
			"options": { "cwd": "${workspaceFolder}" },
			"presentation": { "reveal": "always", "focus": true },
			"problemMatcher": []
		},

		{
			"label": "blink: compile",
			"detail": "Regenerate the networking modules from every bfg-core/Network/*.blink (output is committed)",
			"type": "shell",
			"command": "cd bfg-core/Network && for f in *.blink; do blink \"${f%.blink}\" -y; done",
			"group": { "kind": "build" },
			"options": { "cwd": "${workspaceFolder}", "shell": { "executable": "bash" } },
			"presentation": { "reveal": "always", "focus": false },
			"problemMatcher": []
		},

		{
			"label": "verify places",
			"detail": "Static boot check for both places: unresolved registry lookups, broken core requires",
			"type": "shell",
			"command": "python tools/verify_places.py",
			"group": { "kind": "test" },
			"options": { "cwd": "${workspaceFolder}" },
			"presentation": { "reveal": "always", "focus": true },
			"problemMatcher": []
		},

		{
			"label": "lint",
			"detail": "selene + stylua --check, exactly what the two CI workflows run (bfg-core: Source; parent: Places)",
			"type": "shell",
			"command": "cd bfg-core && selene Source && stylua --syntax Luau --check Source && cd .. && selene Places && stylua --syntax Luau --check Places",
			"group": { "kind": "test" },
			"options": { "cwd": "${workspaceFolder}" },
			"presentation": { "reveal": "always", "focus": true },
			"problemMatcher": []
		}
	]
}
